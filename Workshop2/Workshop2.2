DEEP OCEAN ECOSYSTEMS */
// Miroslava Guerrero

/* The task is to build a map of the world's
major deep ocean ecosystems*/
/* with these type of maps we can assess global
conservation targets set by the convention on 
biological diversity, which require info on how
much of each ecosystem type on earth is within
a protected area */

// PART 1 - IMPORT THE DATA
// Import ETOPO1 and select the bedrock band
var etopo = ee.Image('NOAA/NGDC/ETOPO1');
var bedrock = etopo.select('bedrock');
Map.setCenter(0, 0, 2);
Map.addLayer(bedrock, {min: -8000, max: 0, palette: ['000033','003366','0066cc','66ccff']}, 'Bedrock elevation', false);

// PART 2 - BUILD THE ECOSYSTEM TYPE LAYERS
// --- Hadal trenches and troughs (>6000 m depth) ---
var hadal = bedrock.lt(-6000).selfMask();
// --- Abyssal plains (3000-6000 m depth) ---
var abyssal = bedrock.lt(-3000).and(bedrock.gte(-6000)).selfMask();
// --- Continental and island slopes (250-3000 m depth) ---
var slopeZone = bedrock.lt(-250).and(bedrock.gte(-3000)).selfMask();
// --- Submarine canyons (>200 m depth AND slope >6 degrees) ---
var slopeDegrees = ee.Terrain.slope(bedrock);
var canyons = bedrock.lt(-200).and(slopeDegrees.gt(6)).selfMask();
// Add each to the map with distinct colours
Map.addLayer(hadal, {palette: ['08306b']}, 'Hadal trenches & troughs (>6000m)');
Map.addLayer(abyssal, {palette: ['2171b5']}, 'Abyssal plains (3000-6000m)');
Map.addLayer(slopeZone, {palette: ['6baed6']}, 'Continental & island slopes (250-3000m)');
Map.addLayer(canyons, {palette: ['fd8d3c']}, 'Submarine canyons (>200m, slope >6°)');

// PART 3 - ADD A VECTOR DATASET
// Marine Protected Areas from the World Database on Protected Areas
var wdpa = ee.FeatureCollection('WCMC/WDPA/current/polygons');
var mpas = wdpa.filter(ee.Filter.neq('MARINE', '2')); // keep only marine protected areas
Map.addLayer(mpas.style({color: 'white', fillColor: '00000000', width: 1}), {}, 'Marine Protected Areas');

print(mpas.limit(10)); // inspect the first 10 features and their properties
print(wdpa.aggregate_array('MARINE').distinct()); // see all unique values this field can take

// PART 4 - POLISH THE VISUALISATION
// Build a legend panel
var legend = ui.Panel({style: {position: 'bottom-left', padding: '8px 15px'}});

var legendTitle = ui.Label({
  value: 'Deep Ocean Ecosystems',
  style: {fontWeight: 'bold', fontSize: '16px', margin: '0 0 4px 0'}
});
legend.add(legendTitle);

var makeRow = function(color, name) {
  var colorBox = ui.Label({
    style: {backgroundColor: color, padding: '8px', margin: '4px 0 4px 0'}
  });
  var description = ui.Label({value: name, style: {margin: '4px 0 4px 6px'}});
  return ui.Panel({widgets: [colorBox, description], layout: ui.Panel.Layout.Flow('horizontal')});
};

legend.add(makeRow('#08306b', 'Hadal trenches & troughs (>6000m)'));
legend.add(makeRow('#2171b5', 'Abyssal plains (3000-6000m)'));
legend.add(makeRow('#6baed6', 'Continental & island slopes (250-3000m)'));
legend.add(makeRow('#fd8d3c', 'Submarine canyons (>200m, slope >6°)'));
legend.add(makeRow('#ffffff', 'Marine Protected Areas (outline)'));

Map.add(legend);



