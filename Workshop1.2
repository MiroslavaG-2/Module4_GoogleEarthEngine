// CONFIGURING YOUR MAP
Map.setOptions('SATELLITE') //sets base layer as satellite
Map.setOptions('TERRAIN')
var snazzy = require("users/aazuspan/snazzy:styles");
snazzy.addStyle("https://snazzymaps.com/style/48750/blank-map", "Blank");
Map.setCenter(174.0638, -39.298, 11); // zooms into a volcano in NZ

// IMAGES
// import data from EE data catalogue and add it as a layer
// starting with a dataset of elevation for the whole world
/* using the search bar at the top of the console search 
for SRTM. This is an image dataset, essentially pixels with 
an associated value as a way of showing spatial data */

// Import SRTM data
var dataset = ee.Image("CGIAR/SRTM90_V4") // found when looking for SRTM
print (dataset) // Look at the data properties
Map.addLayer(dataset) // adds the dataset to the map window below

// Customise data layers
/* we can add some parameters to the Map.addLayer. visParms, lets set 
the minimum and maximum pixel values to display */
Map.addLayer(dataset, {min: 0, max: 2500}, 'custom visualization'); 
/* the vis parameter is an object with properties specifying 
the min and max value*/
/* the third parameter is the name of the layer, which can be seen in
the top right of the map window under layers */

/* we can now make it colourful and add more info to the 
visParms object */
Map.addLayer(dataset, {min: 0, max: 2500, palette: ['blue', 'green',
'red']},'custom palette');

// Set up visualisation parameters
var elevationVis = {
  min: 0,
  max: 2500,
  palette: ['0000ff', '00ffff', 'ffff00', 'ff0000', 'ffffff'] /* use
  hex colour codes, bc you can use a much larger range of colours */
};

// Add the data layer to the map
Map.addLayer(dataset, elevationVis, 'Elevation');






