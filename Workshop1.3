Map.setOptions('TERRAIN')

// Single Image: Global Mangrove Forests
var mangroveCollection = ee.ImageCollection('LANDSAT/MANGROVE_FORESTS');
var singleMangroveImage = mangroveCollection.first();

var mangrovesVis = {
  min: 0,
  max: 1.0,
  palette: ['d40115']
};

Map.addLayer(singleMangroveImage, mangrovesVis, 'Mangroves (single image)');

// Single Feature: Laguna de Términos protected area
var protectedAreas = ee.FeatureCollection('WCMC/WDPA/current/polygons');
var laguna = ee.Feature(protectedAreas.filter(ee.Filter.stringContains('NAME', 'rminos')).first());

Map.addLayer(laguna, {color: 'blue'}, 'Laguna de Términos');
Map.centerObject(laguna, 9);

