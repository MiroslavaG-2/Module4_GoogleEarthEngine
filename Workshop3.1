// PROBLEM STATEMENT
/* There has been a massive surge of human 
migration towards developed coastal areas. As a 
result some of these areas have undergone dramatic
transformations as a result from increased human
activity */
/* as part of the state of the world's mangroves
we have been asked to make an assessment of 
where on earth there changes have occured */
/* which of the world's coastlines has been most
transformed by human development */
// confine analysis to first 15 yrs of 20th century

Map.setCenter(122.5, 36.5, 6); // yellow sea zone

// IMAGE DATA
// POPULATION
var population = ee.ImageCollection("CIESIN/GPWv411/GPW_Population_Count")
// print (population)

// Pull images for the years we want
//import two images for start and end
var population_2000 = ee.Image('CIESIN/GPWv411/GPW_Population_Count/gpw_v4_population_count_rev11_2000_30_sec')
var population_2015 = ee.Image('CIESIN/GPWv411/GPW_Population_Count/gpw_v4_population_count_rev11_2015_30_sec')
// print (population_2000)

// Visualise them
var population_vis = {
  'max': 1000.0,
  'palette': [
    'ffffe7',
    '86a192',
    '509791',
    '307296',
    '2c4484',
    '000066'
  ],
  'min': 0.0
};
Map.addLayer(population_2000, population_vis, 'population_count_2000');
Map.addLayer(population_2015, population_vis, 'population_count_2015');

// NIGHTLIGHTS
var nl = ee.ImageCollection("NOAA/DMSP-OLS/NIGHTTIME_LIGHTS")
// print (nl)

// get two images for start and end
var nl_2000 = ee.Image ('NOAA/DMSP-OLS/NIGHTTIME_LIGHTS/F142000')
var nl_2013 = ee.Image ('NOAA/DMSP-OLS/NIGHTTIME_LIGHTS/F182013')
// print(nl_2000)

// Inspect the printed results
/* on inspection of the layers we can see 4 bands
per image. we just need 1 for analysis*/
var nl_2000 = ee.Image('NOAA/DMSP-OLS/NIGHTTIME_LIGHTS/F142000').select(['avg_vis'], ['nightlight']); //select and rename
var nl_2013 = ee.Image('NOAA/DMSP-OLS/NIGHTTIME_LIGHTS/F182013').select(['avg_vis'], ['nightlight']);

var nightlight = {
  bands: ['nightlight'],
  min: 0,
  max: 63,
  palette: ['000000', 'ffffcc', 'ffcc00', 'ff6600', 'ff0000']
};

print('nightlight 2000 processed', nl_2000);
Map.addLayer(nl_2000, nightlight, 'Nighttime Lights 2000');
Map.addLayer(nl_2013, nightlight, 'Nighttime Lights 2013');

// VECTOR DATA
// Import grid
var grid = ee.FeatureCollection('users/murrnick/mb5370/worldgrid_2deg'); // 2 degree grid
// Map.addLayer(grid, {color: 'green'}, 'grid');

// import the coastline dataset
var coast = ee.FeatureCollection('projects/UQ_intertidal/dataMasks/naturalEarthCoastline_v1'); 
// Map.addLayer(coast, {color: 'yellow'}, 'coast'); 

/* Filter grid to only the cells intersecting 
with a coastline */
var coastGrid = grid.filterBounds(coast);
Map.addLayer(coastGrid, {color: 'blue'}, 'coastal grid cells');

// PREPARING FOR GLOBAL ANALYSIS
// limit the size of the analysis
/* fist draw a small geometry and filter for it.
the smaller the better */
/* now build the spatial filter to work only
on ecorigions within the test region. For 
efficiency, we can join our two filters together 
to filter ecoregions to the coast, and then 
those ecoregions to our small area in a single
statement */
// Filter ecoregions to bounds
// Filter grid to coast AND to the small test area
 var coastGrid = grid
  .filter(ee.Filter.bounds(coast))
  // .filter(ee.Filter.bounds(geometry)); // limits to your small test box
Map.addLayer(coastGrid, {color: 'firebrick'}, 'coastal grid (test area)');


// GLOBAL CHANGE
/* work out how much populations and nightlights
have changed over a period */
/* here we can substract the historical pixel
values from the recent pixel values to obtain
change in population over time */
// Population change (2015 minus 2000)
var pop_change = population_2015
  .subtract(population_2000)
  .clip(coastGrid); // or use your test area variable if still testing on the small box
Map.addLayer(pop_change, {palette: ['red', 'black', 'lime'], min: -500, max: 500}, 'pop_change', true, 0.9);

// Nightlight change (2013 minus 2000)
var nl_change = nl_2013
  .subtract(nl_2000)
  .clip(coastGrid); // same here
Map.addLayer(nl_change, {palette: ['red', 'black', 'lime'], min: -50, max: 50}, 'nl_change', true, 0.9);

// average change in nightlights per grid cell
var nl_changePerGrid = nl_change.reduceRegions({
  collection: coastGrid, // or your test area variable, e.g. coastal grid (test area)
  reducer: ee.Reducer.mean(),
  scale: 1000, // computing at a larger scale for speed
});
// print(nl_changePerGrid.first()); // look at properties of the first one
// nightlight change mean 1.618

// average change in population per grid cell
var pop_changePerGrid = pop_change.reduceRegions({
  collection: coastGrid,
  reducer: ee.Reducer.mean(),
  scale: 1000,
});
// print(pop_changePerGrid.first());
// population change mean 184.8544

