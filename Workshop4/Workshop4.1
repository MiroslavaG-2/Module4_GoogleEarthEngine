// THE PROBLEM
/* We are field biologiests trying to decide which
research station to conduct field work on. We are
mainly interested in coral cover. We want to maximise
the amount of coral that can be sampled while at 
the station, and can only conduct field work
from the shore*/
/* need to find research station with the most 
coral cover whithin snorkelling distance from 
the station */

// GLOBAL VARIABLES
var distance = 800 // metres we are allowed to snorkel from the station

// RESEARCH STATION LOCATIONS
/* we need to make a geometry of the locations
of some research stations. We will make point 
features for each research station's coordinate
locations */

Map.setOptions('SATELLITE')
// Map.setCenter( 146.49992691, -18.63411616, 17)// zoom to different stations

/* after selecting 10 stations, create a feature
collection from the features that were done */
var field_stations = ee.FeatureCollection([Heron, Hamilton, Lizard,
Orpheus, Daydream, NewGuinea_Nago, Philippines_IMRS,
Mexico_MARES, Belize_GloversStation, Egypt_NIOF])
print (field_stations)

// DATA
// using the Allan Coral Atlas benthic cover map
// IMPORT THE ACA DATA
// import
var aca = ee.Image('ACA/reef_habitat/v2_0'); // note: NO underscore between "v2" and "0" in the path

// print and review
print('ACA Reef Habitat Dataset', aca);

// add ACA to your map and look at it where your research stations are
Map.setOptions('SATELLITE');
Map.centerObject(field_stations, 4);
var benthicHabitat = aca.select('benthic').selfMask();
Map.addLayer(benthicHabitat, {}, 'Benthic habitat');

// ID coral pixels
var coral = benthicHabitat.eq(15).selfMask();
Map.addLayer(coral, {palette: ['ff6161']}, 'Coral/Algae cover');
