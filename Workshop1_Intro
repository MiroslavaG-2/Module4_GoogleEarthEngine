// VARIABLES
/* Variables are used to store objects, 
and are defined using the keyword var. */

/* the code below creates a variable called the_answer
whith the output 42 */
var the_answer = 42; //number

/* The code below assigns the text 
'San Francisco' to the variable named city */
var city = 'San Francisco';

// can use either '' or "". but be consistent
/* each statement of script typically ends with a 
semicolon, althrough Earth Engine's code editor
doesn't require it */

// when printing the variable city we get the value assigned to it
print (city)

/* when assigning a text value, the variable is automatically
assigned the type string, when assigning numbers, the
variable type is number */
// below it creates a variable and assigns a number as its value
var population = 873965
print (population) /* good habit to print everything
to make sure you know what you're working with */

/* when printing a lot you can also use an argument to
give a descriptive sting as to what it is you are printing */
print('The value for the population variable is:', population)

/* once you have an idea of what the script does, remove all 
print statements from the script, which will make it run 
faster (as it doesn't have to send many results back) */


// LISTS
// lists help store lots of values in a single variable
var cities = ['San Francisco', 'Los Angeles', 'New York', 
'Atlanta'];
print(cities) /* in the console when we expand the list there
is a number next to each value, which is the index of each
item. it allows us to refer to each item using the numeric
value */


// OBJECTS
/* these allow to store key-vlue pairs, where each value can
be referred to by its key */
// few important things about JavaScript syntax:
/* we can use multiple lines to define the object. only after
the semicolon the comman is complete */
/* camel case is when we join multiple words into a single 
variable, for example cityData. */
var cityData = {'city': 'San Francisco',
'coordinates': [-122.4194, 37.7749],
'population': 873965};
print(cityData) /* in the console now each item has a 
label instead of a numeric index. This is known as the key,
and can be used to retrieve the value of an item */


// FUNCTIONS
/* they keep all the technical code in a single spot
in the scrpt, which minimises the chance of making an error
while writing the same statement lots of times */
/* use functions to set up common operations, expected to
be reused throughout a script */
var my_hello_function = function(string) {
  return 'Hello' + string + '!'
};
print(my_hello_function('world'));

// another example
var greet = function(name){
  return 'Hello' + name
};
print(greet('World'));
print(greet('Readers'));

